# Copy to .env and fill in. .env is ignored by git — never commit it.

# Synology NAS IP (NFS server and PostgreSQL host)
NAS_IP=192.168.1.10

# NFS export folder on the Synology (needs data, logs, backups subfolders)
NFS_PATH=/volume1/docker/bambuddy

# PostgreSQL on the Synology
DB_USER=bambuddy
# URL-encode special characters: @ → %40, ! → %21, # → %23, : → %3A, / → %2F
DB_PASSWORD=change-me
# Host port the Postgres container is published on (5432 by default)
DB_PORT=5432
DB_NAME=bambuddy

TZ=America/New_York
PUID=1000
PGID=1000
PORT=8000
